{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Donut Local VPN",
  "mainBinaryName": "donut-local-vpn",
  "version": "0.2.0",
  "identifier": "com.donutvpn.donutlocalvpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Donut Local VPN",
        "width": 380,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Donut VPN",
    "copyright": "© 2026 Donut VPN. Licensed under GPL-3.0.",
    "category": "Utility",
    "shortDescription": "One-click DPI bypass with a local tunnel",
    "longDescription": "Donut Local VPN finds a working DPI bypass setting for your network with one click. On Windows it filters packets with the WinDivert driver; on macOS and Linux it routes all traffic through a local TUN interface. There is no remote server and no account.",
    "homepage": "https://techperson1234.github.io/Donut-VPN/",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
